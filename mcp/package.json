{
  "name": "cybergrok-mcp",
  "version": "1.0.0",
  "description": "TypeScript MCP server for Cybergrok — calls the Python core over JSON RPC",
  "type": "module",
  "bin": {
    "cybergrok-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
