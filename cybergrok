#!/usr/bin/env bash
# Launch Grok Build as the Cybergrok session agent with this plugin and toolchain on PATH.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export CYBERGROK_DIR="${SCRIPT_DIR}"
export CYBERGROK_ROOT="${SCRIPT_DIR}"
export GROK_WORKSPACE_ROOT="${GROK_WORKSPACE_ROOT:-${PWD}}"
export PATH="${SCRIPT_DIR}/tools/wrappers:${SCRIPT_DIR}/tools/bin:${SCRIPT_DIR}/bin:${SCRIPT_DIR}/venv/bin:${PATH}"
umask 0002

if [ -f "${SCRIPT_DIR}/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  source "${SCRIPT_DIR}/.env"
  set +a
fi

if [ -f "${SCRIPT_DIR}/venv/bin/activate" ]; then
  # shellcheck disable=SC1091
  source "${SCRIPT_DIR}/venv/bin/activate"
fi

if ! command -v grok >/dev/null 2>&1; then
  echo "Error: Grok Build CLI ('grok') not found on PATH."
  echo "Install Grok Build, then re-run: ./cybergrok"
  echo "Plugin files are ready: grok plugin install \"${SCRIPT_DIR}\" --trust"
  exit 1
fi

AGENT_FILE="${SCRIPT_DIR}/.grok/agents/cybergrok.md"
if [ ! -f "${AGENT_FILE}" ]; then
  AGENT_FILE="${SCRIPT_DIR}/agents/cybergrok.md"
fi

GROK_ARGS=()
# Do not inherit a harness GROK_AGENT; only honor an explicit --agent from the user.
user_passed_agent=0
for arg in "$@"; do
  if [ "$arg" = "--agent" ]; then
    user_passed_agent=1
    break
  fi
done
if [ "$user_passed_agent" -eq 0 ]; then
  GROK_ARGS+=(--agent "${AGENT_FILE}")
fi
# Folder trust unlocks project plugins and hooks.
GROK_ARGS+=(--trust)

exec grok "${GROK_ARGS[@]}" "$@"
