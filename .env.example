# Cybergrok environment template. Copy to .env and keep secrets out of git.

# Grok Build uses its own login (grok login). Optional xAI key for other clients:
# XAI_API_KEY=

# Rate limits for external recon binaries
NUCLEI_RATE_LIMIT=10
SUBFINDER_RATE_LIMIT=10
HTTPX_RATE_LIMIT=50
KATANA_RATE_LIMIT=10
HTTPX_TIMEOUT=30
KATANA_DEPTH=3

# Optional intercepting proxy
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080

CYBERGROK_WORKSPACE=.
NUCLEI_OUTPUT_DIR=./output/nuclei
RECON_OUTPUT_DIR=./recon
REPORTS_DIR=./reports
LOGS_DIR=./logs
